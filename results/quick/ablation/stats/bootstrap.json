{
  "config": {
    "results_dir": "results/quick/ablation",
    "method": "percentile bootstrap over test examples",
    "ci_level": 0.95,
    "n_boot": 2000,
    "seed": 20261016,
    "classifier": "lr",
    "rng": "numpy.random.default_rng(seed), one fresh generator per (setting, dataset); all variants share its resampled indices (paired)",
    "difference": "variant minus the setting's reference (full LexFront), in fractions (x100 for points)",
    "mcnemar": "exact two-sided binomial test on discordant pairs, accuracy, every variant vs reference",
    "multiplicity": "none: every interval is a separate 95% interval",
    "rule_fires": "per split: documents whose token list (docs) and lexer tokens whose normalized form (tokens) differ from full LexFront, on the text LexFront sees in the setting; 0 in train and test means the variant is the full system (not a test of the rule)",
    "not_covered": "training randomness: one training run per cell (seed 0)",
    "numpy": "2.4.6",
    "settings": {
      "main": {
        "label": "TF-IDF lowercase (main grid)",
        "vectorizer_overrides": {},
        "reference": "full",
